# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Environment ---
.venv/
venv/
env/
.env
config/local.toml

# --- Data ---
# Generated and downloaded data never enters the repository.
# Synthetic worlds are reproducible from a seed; regenerate, do not commit.
data/raw/*
data/interim/*
data/processed/*
data/synthetic/*
!data/**/.gitkeep

# --- Simulation outputs ---
# Anchored to the repo root: an unanchored "outputs/" also matches
# mre/outputs/, the engine's serialisation package, and silently drops it
# from every commit. That is exactly what happened before this fix.
/outputs/
*.gpkg
# Real pilot data is regenerated from OpenStreetMap (ODbL) via the fetch
# script, not committed. The seed/bbox is the artifact, like the synthetic seed.
*.geojson
*.geojson
*.tif
*.tiff
*.parquet

# --- Blender ---
*.blend1
*.blend2
blender/out/
*.glb

# --- OS / editor ---
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# --- Claude Code local tooling ---
.claude/settings.local.json
